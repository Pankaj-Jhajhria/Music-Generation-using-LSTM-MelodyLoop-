data_maestrov3.0.0-midi/
data_maestro3.0.0-midi/
data_midicaps/
data/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
.env/
ENV/
.pytest_cache/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
~$*.pptx
~$*.docx

# Dynamic runtime audio & video outputs
*.wav
*.mp3
*.mp4
*.webp

# Temporary artifacts & training caches
artifacts/cache/
artifacts/logs/
artifacts/slide_renders/
artifacts/generated/

# Keep Model Checkpoints for Streamlit Deployment
!artifacts/
!artifacts/checkpoints/
!artifacts/checkpoints/best_model.pt
!artifacts/checkpoints/best_model_expanded.pt
!artifacts/checkpoints/best_model_v1_baseline.pt
!artifacts/checkpoints/latest_model.pt
