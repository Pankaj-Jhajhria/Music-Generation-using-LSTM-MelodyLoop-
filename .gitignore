!artifacts/checkpoints/latest_model_v1_baseline.pt

# Keep Presentation & Document Visual Assets
!artifacts/presentation_assets/
!artifacts/presentation_assets/**

# Keep Bundled Sample Pieces for Streamlit Cloud
!data_samples/
!data_samples/**
